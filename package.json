{
  "name": "bcuk-bot-4",
  "version": "1.0.0",
  "description": "Community bot",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "node node_modules/typescript7/bin/tsc -p tsconfig.build.json",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:toolchain": "vitest run --config vitest.toolchain.config.mts",
    "lint": "eslint .",
    "check:circular": "node scripts/checkCircularDeps.js",
    "check:unused": "knip",
    "deploy": "bash deploy.sh"
  },
  "dependencies": {
    "@discordjs/builders": "^1.15.0",
    "@discordjs/formatters": "^0.6.2",
    "@discordjs/rest": "^2.6.3",
    "@discordjs/voice": "^0.19.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@twurple/auth": "^8.2.0",
    "@twurple/chat": "^8.2.0",
    "discord-api-types": "^0.38.57",
    "discord.js": "^14.28.0",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "ffmpeg-static": "^5.2.0",
    "helmet": "^8.3.0",
    "mediaplex": "^1.0.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "openai": "^7.47.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.9.0"
  },
  "overrides": {
    "ws": ">=8.21.1",
    "undici": "^6.29.1",
    "mysql2": "^3.24.6",
    "qs": ">=6.16.0",
    "minimatch": "^11.0.1",
    "madge": {
      "typescript": "$typescript",
      "dependency-tree": {
        "filing-cabinet": {
          "typescript": "$typescript"
        }
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-mysql-session": "^3.0.8",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "knip": "6.43.0",
    "madge": "^8.0.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
