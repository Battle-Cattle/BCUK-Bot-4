{
  "name": "bcuk-bot-4",
  "version": "1.0.0",
  "description": "Community bot",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "graphify:hook": "graphify hook install",
    "deploy": "bash deploy.sh"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@twurple/auth": "^8.1.4",
    "@twurple/chat": "^8.1.4",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.19.0",
    "ffmpeg-static": "^5.2.0",
    "helmet": "^8.3.0",
    "libsodium-wrappers": "^0.8.4",
    "mediaplex": "^1.0.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.1",
    "openai": "^7.3.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "overrides": {
    "ws": ">=8.21.1",
    "undici": "^7.29.0",
    "mysql2": "^3.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-mysql-session": "^3.0.8",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
