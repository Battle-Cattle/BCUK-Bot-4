<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BCUK Bot — Health</title>
  <link rel="stylesheet" href="/style.css">
  <%- include('partials/pwa-head') %>
<%
/** JSON-stringifies `value` and HTML-escapes the result so it's safe to embed inside a double-quoted HTML attribute; returns the escaped string. */
function htmlAttrJson(value) {
  const replacements = { '&': '&amp;', '"': '&quot;', "'": '&#39;', '<': '&lt;', '>': '&gt;' };
  return JSON.stringify(value).replace(/[&"'<>]/g, function(char) { return replacements[char] || char; });
}
%>
</head>
<!-- Unescaped EJS output here is intentional: htmlAttrJson() already HTML-escapes its result via manual character replacement, so the escaping EJS tag would double-escape the attribute value. -->
<body data-initial-health="<%- htmlAttrJson(health) %>">
  <%- include('partials/nav') %>

  <main class="container">
    <section class="section">
      <h2 class="section-title">Bot Health</h2>

      <% if (success === 'debug_on') { %>
      <div class="card card-alert-success">Debug logging is on. It switches itself off at the time shown below.</div>
      <% } else if (success === 'debug_off') { %>
      <div class="card card-alert-success">Debug logging is off.</div>
      <% } else if (error === 'debug_invalid') { %>
      <div class="card card-alert-danger" role="alert">Pick one of the listed durations.</div>
      <% } else if (error === 'debug_failed') { %>
      <div class="card card-alert-danger" role="alert">Couldn't change debug logging. Check the server logs.</div>
      <% } %>

      <div class="table-scroll">
        <table class="table" id="health-table" aria-label="Component health">
          <thead>
            <tr>
              <th scope="col">Component</th>
              <th scope="col">State</th>
              <th scope="col">Last event</th>
              <th scope="col">Last error</th>
            </tr>
          </thead>
          <tbody id="health-table-body">
            <!-- Populated by /health.js from the server-rendered snapshot and live SSE updates. -->
          </tbody>
        </table>
      </div>

      <div class="card card-spaced">
        <div class="card-header">
          <span class="card-icon">&#128269;</span>
          <span class="card-label">Debug Logging</span>
        </div>
        <% if (debugLoggingUntil) { %>
        <p>On until <strong><%= debugLoggingUntil.toISOString().replace('T', ' ').slice(0, 16) %> UTC</strong>, writing to <code>logs/debug-YYYY-MM-DD.log</code>.</p>
        <form method="POST" action="/admin/health/debug-logging" class="inline-form-sm">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="action" value="disable">
          <button type="submit" class="btn btn-sm btn-ghost">Turn off now</button>
        </form>
        <% } else { %>
        <p class="muted">Off. Turn it on to write debug lines to their own file, <code>logs/debug-YYYY-MM-DD.log</code>. It switches itself off when the time runs out.</p>
        <% } %>
        <form method="POST" action="/admin/health/debug-logging" class="d-flex gap-04 flex-wrap">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="action" value="enable">
          <label for="debug-logging-hours">Keep on for</label>
          <select class="input" id="debug-logging-hours" name="hours">
            <% debugLoggingHourOptions.forEach(function (h) { %>
            <option value="<%= h %>"<%= h === defaultDebugLoggingHours ? ' selected' : '' %>><%= h %> hour<%= h === 1 ? '' : 's' %></option>
            <% }) %>
          </select>
          <button type="submit" class="btn btn-sm"><%= debugLoggingUntil ? 'Restart timer' : 'Turn on' %></button>
        </form>
      </div>

      <div class="card card-spaced">
        <div class="card-header">
          <span class="card-icon">&#9888;</span>
          <span class="card-label">Recent Errors</span>
        </div>
        <div id="health-errors">
          <p class="muted" id="health-errors-empty">No recent errors.</p>
          <ul class="list-unstyled" id="health-errors-list"></ul>
        </div>
      </div>
    </section>
  </main>
  <%- include('partials/pwa-register') %>
  <%- include('partials/footer') %>
  <script src="/health.js"></script>
</body>
</html>
