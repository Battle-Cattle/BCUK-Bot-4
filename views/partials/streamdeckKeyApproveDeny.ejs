<%# Approve/Deny buttons for a pending Streamdeck API key request. Locals: csrfToken, discordId — the requester's Discord snowflake. -%>
<div class="d-flex gap-04 flex-wrap">
  <form method="POST" action="/admin/streamdeck-keys/approve" class="inline-form-sm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="discord_id" value="<%= discordId %>">
    <button type="submit" class="btn btn-sm">Approve</button>
  </form>
  <form method="POST" action="/admin/streamdeck-keys/deny" class="inline-form-sm js-confirm-deny-key">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="discord_id" value="<%= discordId %>">
    <button type="submit" class="btn btn-sm btn-ghost">Deny</button>
  </form>
</div>
