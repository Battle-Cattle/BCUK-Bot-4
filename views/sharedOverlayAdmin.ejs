<%- include('partials/head', { pageTitle: 'BCUK Bot — Shared Video Overlay' }) %>
</head>
<body data-csrf-token="<%= csrfToken %>">
  <%- include('partials/nav') %>

  <main class="container">

    <% if (error) { %>
    <div class="card card-alert-danger">
      <% const errorMessages = {
        invalid_id:       'That video id is not valid.',
        invalid_name:     'Enter a name for the video.',
        not_found:        'That video no longer exists.',
        not_a_streamer:   'You are not configured as a monitored streamer, so you have no videos of your own to add.',
        invalid_file:     'No valid file was uploaded. Accepted formats: WebM, MP4, MOV.',
        transcode_failed: 'The video could not be converted to WebM. Check it plays locally, or export it as WebM.',
        transcode_busy:   'Other videos are being converted right now. Try again in a few minutes.',
        upload_busy:      'Another upload is already in progress. Try again once it finishes.',
        upload_incomplete:'The upload did not finish arriving — please try again.',
        upload_expired:   'The upload expired before it finished — please try again.',
        invalid_upload:   'No valid file was chosen.',
        upload_failed:    'Upload failed — please try again.',
        delete_failed:    'Delete failed — please try again.',
        save_failed:      'Saving failed — please try again.'
      }; %>
      <p><%= errorMessages[error] || 'Something went wrong.' %></p>
    </div>
    <% } %>

    <% if (success) { %>
    <div class="card card-alert-success">
      <% const successMessages = {
        video_uploaded: 'Video uploaded and converted. Connected overlays have the new list.',
        video_renamed:  'Video renamed.',
        video_enabled:  'Video enabled.',
        video_disabled: 'Video disabled.',
        video_deleted:  'Video deleted.',
        video_added:    'Video added to the shared list.'
      }; %>
      <p><%= successMessages[success] || 'Done.' %></p>
    </div>
    <% } %>

    <section class="section">
      <h2 class="section-title">Shared Video Overlay</h2>
      <div class="card card-spaced">
        <div class="card-body">
          <p class="hint hint-compact">Streamers add <code class="mono"><%= baseUrl %>/overlay/shared/&lt;their Twitch login&gt;</code> as a Browser Source in OBS. Any Stream Deck key can then play one of these videos on every connected overlay at once.</p>
          <p class="mt-05"><strong><%= connectedCount %></strong> shared overlay<%= connectedCount === 1 ? '' : 's' %> connected right now.</p>
        </div>
      </div>

      <div class="card card-spaced">
        <div class="card-body">
          <h3 class="section-title">Readiness</h3>
          <p class="hint hint-compact">Each overlay reports which videos it has stored (self-reported; it only affects this page). Updates live.</p>
          <h4>Per overlay</h4>
          <ul id="readiness-overlays"><li class="hint">Loading…</li></ul>
          <h4>Per video</h4>
          <ul id="readiness-videos"><li class="hint">Loading…</li></ul>
        </div>
      </div>

      <div class="card card-spaced">
        <div class="card-body">
          <form method="POST" action="/overlay/shared/settings/upload" enctype="multipart/form-data" class="js-shared-upload"
                data-progress-url="/overlay/shared/settings/progress" data-processing-label="Converting…">
            <div class="form-row-wrap items-end">
              <div class="flex-1">
                <label class="hint hint-compact" for="shared-video-name">Name</label>
                <input id="shared-video-name" class="input" type="text" name="name" maxlength="100" placeholder="e.g. Confetti Explosion">
              </div>
              <div class="flex-1">
                <label class="hint hint-compact" for="shared-video-file">Video file (WebM, MP4 or MOV)</label>
                <input id="shared-video-file" class="input" type="file" name="video" accept="video/webm,video/mp4,video/quicktime,.mov" required>
              </div>
              <div>
                <button type="submit" class="btn">Upload</button>
              </div>
            </div>
            <div class="upload-progress is-hidden mt-04" data-upload-progress>
              <progress class="upload-progress-bar" max="100" value="0" aria-label="Upload progress"></progress>
              <span class="hint" data-upload-progress-label role="status" aria-live="polite"></span>
            </div>
            <p class="hint mt-04">Every upload is converted to WebM, which can take a minute. Max <%= maxFileMb %> MB per file.</p>
          </form>
        </div>
      </div>

      <% if (videos.length === 0) { %>
      <div class="card"><div class="card-body"><p class="hint">No shared videos yet.</p></div></div>
      <% } else { %>
      <div class="card">
        <div class="table-scroll">
          <table class="table full-width">
            <thead>
              <tr><th>Name</th><th>Added by</th><th>Added</th><th>Status</th><th></th><th></th></tr>
            </thead>
            <tbody>
              <% for (const v of videos) { %>
              <tr>
                <td>
                  <form method="POST" action="/overlay/shared/settings/<%= v.id %>/rename" class="m-0 form-row-wrap items-end">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input class="input" type="text" name="name" maxlength="100" value="<%= v.name %>" aria-label="Video name">
                    <button type="submit" class="btn btn-ghost btn-sm">Rename</button>
                  </form>
                </td>
                <td><%= v.uploader_login || 'unknown' %></td>
                <td><%= new Date(v.created_at).toLocaleDateString() %></td>
                <td><%= v.enabled ? 'Enabled' : 'Disabled' %></td>
                <td>
                  <form method="POST" action="/overlay/shared/settings/<%= v.id %>/enabled" class="m-0">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="enabled" value="<%= v.enabled ? '0' : '1' %>">
                    <button type="submit" class="btn btn-ghost btn-sm"><%= v.enabled ? 'Disable' : 'Enable' %></button>
                  </form>
                </td>
                <td>
                  <form method="POST" action="/overlay/shared/settings/<%= v.id %>/delete" class="m-0 js-confirm-delete-shared-video">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-ghost btn-sm">Delete</button>
                  </form>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>
    </section>

    <% if (ownVideos.length > 0) { %>
    <section class="section">
      <h2 class="section-title">Add one of your overlay videos</h2>
      <div class="card">
        <div class="table-scroll">
          <table class="table full-width">
            <tbody>
              <% for (const v of ownVideos) { %>
              <tr>
                <td><%= v.name %></td>
                <td>
                  <form method="POST" action="/overlay/shared/settings/import/<%= v.id %>" class="m-0">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-ghost btn-sm">Add to shared list</button>
                  </form>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
      <p class="hint mt-04">Converts a copy to WebM; your own video is left as it is. Converting can take a minute.</p>
    </section>
    <% } %>

  </main>

  <%- include('partials/page-end') %>
  <script src="/sseClient.js"></script>
  <script src="/sharedOverlayReadiness.js"></script>
  <script src="/chunkedUpload.js"></script>
  <script src="/chunkedUploadResume.js"></script>
  <script src="/chunkedUploadOutcome.js"></script>
  <script src="/chunkedUploadPacing.js"></script>
  <script src="/sharedOverlayAdmin.js"></script>
</body>
</html>
