<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BCUK Bot — Stream Monitor</title>
  <link rel="stylesheet" href="/style.css">
  <%- include('partials/pwa-head') %>
</head>
<body>
  <%- include('partials/nav') %>

  <main class="container">

    <% if (error) { %>
    <div class="card card-alert-danger">
      <%= getFriendlyError(error) %>
      <% if (error === 'eventsub_wrong_account' && successExpectedAccount) { %>
        Expected account: <strong><%= successExpectedAccount %></strong>
      <% } %>
    </div>
    <% } %>
    <% if (success === 'twitch_connected') { %>
    <div class="card card-alert-success">Twitch account connected successfully.</div>
    <% } %>

    <!-- ── Live Now ─────────────────────────────────────────────────── -->
    <section class="section">
      <h2 class="section-title">Live Now</h2>
      <div class="card">
        <div class="card-header">
          <span class="card-icon">🔴</span>
          <span class="card-label">Currently Tracked Live Streams</span>
          <span id="live-updated" class="live-updated-meta"></span>
        </div>
        <div class="table-scroll">
        <table class="table" id="live-table" aria-label="Currently live streams">
          <thead>
            <tr>
              <th scope="col">Details</th>
              <th scope="col">Streamer</th>
              <th scope="col">Group</th>
              <th scope="col">Game</th>
              <th scope="col">Title</th>
              <th scope="col">Discord Post</th>
            </tr>
          </thead>
          <tbody id="live-tbody">
            <tr><td colspan="6" class="empty-msg">Loading…</td></tr>
          </tbody>
        </table>
        </div>
      </div>
    </section>

    <!-- ── Stream groups ───────────────────────────────────────────── -->
    <section class="section">
      <h2 class="section-title">Stream Groups</h2>

      <div class="card card-spaced">
        <div class="card-header"><span class="card-icon">➕</span><span class="card-label">Add Group</span></div>
        <div class="card-body">
          <form method="POST" action="/admin/streams/groups/add">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-row-wrap form-section-gap">
              <input class="input input-grow-160" type="text" name="name" placeholder="Group name" required>
              <input class="input input-grow-180" type="text" name="discord_channel" placeholder="Discord channel ID" required>
              <label class="input checkbox-input-label">
                <input type="checkbox" name="multi_twitch"> Multi-Twitch links
              </label>
              <label class="input checkbox-input-label">
                <input type="checkbox" name="delete_old_posts"> Delete old posts on game change
              </label>
            </div>
            <div class="form-subsection-gap">
              <p class="hint hint-compact">Live message — shown when a stream goes live. Variables: <code>{streamer} {game} {title} {url}</code></p>
              <textarea class="input stream-textarea" name="live_message" rows="2" placeholder="@everyone {streamer} is now live playing {game}! {url}" required></textarea>
            </div>
            <div class="form-subsection-gap">
              <p class="hint hint-compact">Game change message — shown when the streamer switches games. Same variables.</p>
              <textarea class="input stream-textarea" name="new_game_message" rows="2" placeholder="{streamer} switched to {game}! {url}" required></textarea>
            </div>
            <button type="submit" class="btn">Add Group</button>
          </form>
        </div>
      </div>

      <div class="card">
        <div class="table-scroll">
        <table class="table" aria-label="Stream groups">
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Channel ID</th>
              <th scope="col">Multi-Twitch</th>
              <th scope="col">Delete Old</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% groups.forEach(function(g) { %>
            <tr class="sfx-row">
              <td><strong><%= g.name %></strong></td>
              <td class="mono"><%= g.discord_channel %></td>
              <td><span class="badge <%= g.multi_twitch ? 'badge-active' : '' %>"><%= g.multi_twitch ? 'Yes' : 'No' %></span></td>
              <td><span class="badge <%= g.delete_old_posts ? 'badge-active' : '' %>"><%= g.delete_old_posts ? 'Yes' : 'No' %></span></td>
              <td>
                <div class="actions">
                  <button type="button" class="btn btn-sm btn-ghost btn-toggle-group-edit" data-group-id="<%= g.id %>">✏️ Edit</button>
                  <form method="POST" action="/admin/streams/groups/remove" class="inline-form-sm js-confirm-remove-group" data-group-name="<%= g.name %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="group_id" value="<%= g.id %>">
                    <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                  </form>
                </div>
              </td>
            </tr>
            <tr class="files-row is-hidden" id="group-edit-<%= g.id %>">
              <td colspan="5">
                <div class="edit-panel">
                  <form method="POST" action="/admin/streams/groups/update">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="group_id" value="<%= g.id %>">
                    <div class="form-row-wrap form-section-gap">
                      <input class="input input-grow-160" type="text" name="name" value="<%= g.name %>" required>
                      <input class="input input-grow-180" type="text" name="discord_channel" value="<%= g.discord_channel %>" required>
                      <label class="input checkbox-input-label">
                        <input type="checkbox" name="multi_twitch" <%= g.multi_twitch ? 'checked' : '' %>> Multi-Twitch links
                      </label>
                      <label class="input checkbox-input-label">
                        <input type="checkbox" name="delete_old_posts" <%= g.delete_old_posts ? 'checked' : '' %>> Delete old posts on game change
                      </label>
                    </div>
                    <div class="form-subsection-gap">
                      <p class="hint hint-compact">Live message</p>
                      <textarea class="input stream-textarea" name="live_message" rows="2" required><%= g.live_message %></textarea>
                    </div>
                    <div class="form-subsection-gap">
                      <p class="hint hint-compact">Game change message</p>
                      <textarea class="input stream-textarea" name="new_game_message" rows="2" required><%= g.new_game_message %></textarea>
                    </div>
                    <div class="button-row-wrap">
                      <button type="submit" class="btn">Save Changes</button>
                      <button type="button" class="btn btn-ghost btn-toggle-group-edit" data-group-id="<%= g.id %>">Cancel</button>
                    </div>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
            <% if (groups.length === 0) { %>
            <tr><td colspan="5" class="empty-msg">No stream groups configured yet.</td></tr>
            <% } %>
          </tbody>
        </table>
        </div>
      </div>
    </section>

    <!-- ── Streamers ────────────────────────────────────────────────── -->
    <section class="section">
      <h2 class="section-title">Streamers</h2>

      <% if (groups.length > 0) { %>
      <div class="card card-spaced">
        <div class="card-header"><span class="card-icon">➕</span><span class="card-label">Add Streamer</span></div>
        <form method="POST" action="/admin/streams/streamers/add" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input class="input" type="text" name="name" placeholder="Twitch username (lowercase)" required>
          <select class="input" name="group_id">
            <% groups.forEach(function(g) { %>
            <option value="<%= g.id %>"><%= g.name %></option>
            <% }) %>
          </select>
          <button type="submit" class="btn">Add Streamer</button>
        </form>
      </div>
      <% } %>

      <div class="card">
        <div class="table-scroll">
        <table class="table" aria-label="Streamers">
          <thead>
            <tr>
              <th scope="col">Username</th>
              <th scope="col">Group</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% streamers.forEach(function(s) {
              const esData = isAdmin ? (eventSubById[s.id] || null) : null;
              const isBotEnabled = isAdmin && botEnabledSet.has(s.name);
              const isConnected = !!(esData && esData.eventsub_access_token);
              const cfg = esData && esData.config;
            %>
            <tr>
              <td class="mono">
                <%= s.name %>
                <% if (isAdmin && isBotEnabled) { %>
                  <% if (isConnected) { %>
                  <span class="badge badge-active" title="Twitch account connected for notifications">🔔</span>
                  <% } else { %>
                  <span class="badge" title="Notifications not connected">🔕</span>
                  <% } %>
                <% } %>
              </td>
              <td><%= s.group_name %></td>
              <td>
                <div class="actions">
                  <% if (isAdmin && isBotEnabled) { %>
                  <button type="button" class="btn btn-sm btn-ghost btn-toggle-eventsub" data-streamer-id="<%= s.id %>">🔔 Notifications</button>
                  <% } %>
                  <form method="POST" action="/admin/streams/streamers/remove" class="inline-form-sm js-confirm-remove-streamer" data-streamer-name="<%= s.name %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="streamer_id" value="<%= s.id %>">
                    <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                  </form>
                </div>
              </td>
            </tr>
            <% if (isAdmin && isBotEnabled) { %>
            <tr class="files-row is-hidden" id="eventsub-<%= s.id %>">
              <td colspan="3">
                <div class="edit-panel">
                  <div class="form-row-wrap form-section-gap" style="align-items:center;margin-bottom:0.75rem;">
                    <strong>Twitch Notifications — <%= s.name %></strong>
                    <% if (isConnected) { %>
                    <span class="badge badge-active">✓ Connected</span>
                    <form method="POST" action="/admin/streams/twitch-disconnect/<%= s.id %>" class="inline-form-sm">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-ghost btn-sm">Disconnect</button>
                    </form>
                    <% } else { %>
                    <span class="badge">⚠ Not connected</span>
                    <a href="/admin/streams/twitch-oauth/<%= s.id %>" class="btn btn-sm">Connect Twitch</a>
                    <% } %>
                  </div>
                  <form method="POST" action="/admin/streams/event-config/<%= s.id %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="form-subsection-gap">
                      <label class="input checkbox-input-label">
                        <input type="checkbox" name="follow_enabled" <%= (cfg && cfg.follow_enabled) ? 'checked' : '' %> <%= !isConnected ? 'disabled' : '' %>>
                        Follow notifications <% if (!isConnected) { %><span class="hint">(requires Twitch connection)</span><% } %>
                      </label>
                      <p class="hint hint-compact">Variables: <code>{username} {display_name}</code></p>
                      <textarea class="input stream-textarea" name="follow_message" rows="1" maxlength="500" <%= !isConnected ? 'disabled' : '' %>><%= (cfg && cfg.follow_message) ? cfg.follow_message : 'Thanks {display_name} for the follow!' %></textarea>
                    </div>

                    <div class="form-subsection-gap">
                      <label class="input checkbox-input-label">
                        <input type="checkbox" name="sub_enabled" <%= (cfg && cfg.sub_enabled) ? 'checked' : '' %> <%= !isConnected ? 'disabled' : '' %>>
                        Sub/resub/gift notifications <% if (!isConnected) { %><span class="hint">(requires Twitch connection)</span><% } %>
                      </label>
                      <p class="hint hint-compact">New sub — variables: <code>{username} {display_name} {tier} {tier_name}</code></p>
                      <textarea class="input stream-textarea" name="sub_message" rows="1" maxlength="500" <%= !isConnected ? 'disabled' : '' %>><%= (cfg && cfg.sub_message) ? cfg.sub_message : 'Thanks {display_name} for subscribing! (Tier {tier_name})' %></textarea>
                      <p class="hint hint-compact" style="margin-top:0.4rem;">Resub — variables: <code>{username} {display_name} {tier} {tier_name} {months} {streak}</code></p>
                      <textarea class="input stream-textarea" name="resub_message" rows="1" maxlength="500" <%= !isConnected ? 'disabled' : '' %>><%= (cfg && cfg.resub_message) ? cfg.resub_message : 'Thanks {display_name} for {months} months! (Tier {tier_name})' %></textarea>
                      <p class="hint hint-compact" style="margin-top:0.4rem;">Gift sub — variables: <code>{gifter} {gifter_display} {count} {tier} {tier_name}</code></p>
                      <textarea class="input stream-textarea" name="giftsub_message" rows="1" maxlength="500" <%= !isConnected ? 'disabled' : '' %>><%= (cfg && cfg.giftsub_message) ? cfg.giftsub_message : '{gifter_display} gifted {count} sub(s) to the community!' %></textarea>
                    </div>

                    <div class="form-subsection-gap">
                      <label class="input checkbox-input-label">
                        <input type="checkbox" name="raid_enabled" <%= (cfg && cfg.raid_enabled) ? 'checked' : '' %>>
                        Raid notifications
                      </label>
                      <p class="hint hint-compact">Variables: <code>{from_channel} {from_display} {viewers}</code></p>
                      <textarea class="input stream-textarea" name="raid_message" rows="1" maxlength="500"><%= (cfg && cfg.raid_message) ? cfg.raid_message : 'Welcome raiders from {from_channel}! Thank you for the {viewers} person raid!' %></textarea>
                    </div>

                    <div class="button-row-wrap">
                      <button type="submit" class="btn">Save</button>
                      <button type="button" class="btn btn-ghost btn-toggle-eventsub" data-streamer-id="<%= s.id %>">Cancel</button>
                    </div>
                  </form>
                </div>
              </td>
            </tr>
            <% } %>
            <% }) %>
            <% if (streamers.length === 0) { %>
            <tr>
              <td colspan="3" class="empty-msg">
                <% if (groups.length === 0) { %>
                Add a stream group above before adding streamers.
                <% } else { %>
                No streamers configured yet.
                <% } %>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
        </div>
      </div>
    </section>

  </main>

  <%- include('partials/pwa-register') %>
  <script>
    document.querySelectorAll('.btn-toggle-eventsub').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var id = btn.getAttribute('data-streamer-id');
        var row = document.getElementById('eventsub-' + id);
        if (row) row.classList.toggle('is-hidden');
      });
    });
  </script>
  <script src="/utils.js"></script>
  <script src="/streams-utils.js"></script>
  <script src="/streams-discord.js"></script>
  <script src="/streams-live-detail.js"></script>
  <script src="/streams-live-table.js"></script>
  <script src="/streams-live-poll.js"></script>
</body>
</html>
