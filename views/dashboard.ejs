<%- include('partials/head', { pageTitle: 'BCUK Bot — Dashboard' }) %>
<%
function htmlAttrJson(value) {
  const replacements = { '&': '&amp;', '"': '&quot;', "'": '&#39;', '<': '&lt;', '>': '&gt;' };
  return JSON.stringify(value).replace(/[&"'<>]/g, function(char) { return replacements[char] || char; });
}
%>
</head>
<!-- Unescaped EJS output here is intentional: htmlAttrJson() already HTML-escapes its result via manual character replacement, so the escaping EJS tag would double-escape the attribute value. -->
<body data-initial-status="<%- htmlAttrJson(status) %>" data-initial-events="<%- htmlAttrJson(recentEvents) %>" data-has-streamer="<%= hasStreamer %>" data-csrf-token="<%= csrfToken %>"<% if (ownChannel) { %> data-own-channel="<%= ownChannel %>"<% } %>>
  <%- include('partials/nav') %>

  <main class="container container--wide">
    <div class="dashboard-layout">

      <%# Welcome hero: a short greeting (the page's h1) and the existing Quick Links as compact actions, in the left
          column so the right-hand column's height budget is unchanged. Nothing here is new: the same destinations at
          the same access levels (Commands and Counters Manager+ only) the old Quick Links section had. %>
      <section class="dashboard-hero" aria-labelledby="dashboard-welcome">
        <div class="hero-text">
          <h1 class="hero-title" id="dashboard-welcome"><%= user ? 'Welcome back, ' + user.discordName + '!' : 'Welcome to BCUK Bot' %></h1>
          <p class="hero-subtitle">Your Battle Cattle dashboard at a glance.</p>
        </div>
        <nav class="hero-actions" aria-label="Quick links">
          <a href="/sfx" class="hero-action"><span class="hero-action-icon" aria-hidden="true">🎧</span>SFX <span class="hero-count"><%= usageStats.sfxCount %></span></a>
          <% if (user && user.accessLevel >= 2) { %>
          <a href="/commands" class="hero-action"><span class="hero-action-icon" aria-hidden="true">💻</span>Commands <span class="hero-count"><%= usageStats.commandCount %></span></a>
          <a href="/counters" class="hero-action"><span class="hero-action-icon" aria-hidden="true">🔢</span>Counters <span class="hero-count"><%= usageStats.counterCount %></span></a>
          <% } %>
          <a href="/channel-points" class="hero-action"><span class="hero-action-icon" aria-hidden="true">🪙</span>Channel Points</a>
          <a href="/loyalty-points" class="hero-action"><span class="hero-action-icon" aria-hidden="true">🏆</span>Loyalty Points</a>
          <a href="/alerts/settings" class="hero-action"><span class="hero-action-icon" aria-hidden="true">🔔</span>Alerts</a>
        </nav>
      </section>

      <!-- ── System Status: one panel for the bot's services (Discord, Voice, Twitch chat), with the last sound played inside the Voice service.
           Each service keeps its own state text, dot and controls; broadcast state is not part of it. ── -->
      <section class="section dashboard-status" id="bot-status">
        <%# The one overall health indicator: a roll-up of the required services (Discord, and the Twitch chat connections
            when any are configured), never voice or live state. dashboard-health.js derives it from the status feed;
            it starts Unknown so the page never claims health before data arrives. It sits on this heading row, so it
            adds no height of its own and sits next to the panel it summarises. %>
        <div class="section-header">
          <h2 class="section-title">System Status</h2>
          <div id="health-indicator" class="health health--unknown" data-state="unknown" role="status">Status unknown</div>
        </div>
        <p id="status-stale-note" class="status-stale-note" hidden>Status unknown: these are the last values received, not live.</p>
        <div class="status-layout">

          <div class="card system-status">

            <div class="service service--discord" id="card-discord">
              <div class="service-header">
                <span class="card-icon">💬</span>
                <h3 class="service-label">Discord Bot</h3>
                <span class="stat-value status-text" id="discord-state">—</span>
                <span class="dot dot--offline" id="dot-discord" role="img" aria-label="Discord: Disconnected" title="Discord: Disconnected"></span>
              </div>
              <div class="service-body">
                <div class="stat-row"><span class="stat-label">Account</span><span class="stat-value" id="discord-tag">—</span></div>
                <div class="stat-row"><span class="stat-label">Server</span><span class="stat-value" id="discord-guild">—</span></div>
              </div>
            </div>

            <div class="service service--voice" id="card-voice">
              <div class="service-header">
                <span class="card-icon">🔊</span>
                <h3 class="service-label">Voice Channel</h3>
                <span class="stat-value status-text" id="voice-state">—</span>
                <span class="dot dot--inactive" id="dot-voice" role="img" aria-label="Voice: Not connected" title="Voice: Not connected"></span>
              </div>
              <div class="service-body">
                <div class="stat-row"><span class="stat-label">Channel</span><span class="stat-value" id="voice-channel">—</span></div>
                <%# The last sound played in this guild: its command, file, where it came from, who triggered it and when, on one
                    wrapping line. Playback information, not a health state. dashboard-status.js fills it from the status feed
                    (names are written as text only, never as markup), so nothing user-controlled is rendered here. %>
                <p class="last-played"><span class="stat-label">Last played</span> <span class="last-played-line" id="voice-last-played">—</span></p>
                <% if (user && user.accessLevel >= 1) { %>
                <div class="stat-row stat-row-top-gap">
                  <div class="d-flex flex-wrap gap-05 items-center">
                    <select class="btn btn-sm flex-1 min-w-120" id="voice-channel-select" aria-label="Voice channel">
                      <option value="">Loading channels...</option>
                    </select>
                    <button class="btn btn-sm" id="btn-rejoin-voice"><%= status.voice.connected ? 'Leave Voice' : 'Join Voice' %></button>
                  </div>
                </div>
                <% } %>
              </div>
            </div>

            <!-- Twitch chat connections: the roll-up of every channel (words and an icon; dashboard-status.js fills it
                 from the status feed), then one row per channel in a labelled scroll region that fills the column. -->
            <div class="service service--twitch" id="card-twitch">
              <div class="service-header">
                <span class="card-icon">🟣</span>
                <h3 class="service-label">Twitch Channels</h3>
                <span class="stat-value status-text" id="twitch-state">—</span>
                <span class="dot dot--unknown" id="dot-twitch" role="img" aria-label="Twitch: Status unknown" title="Twitch: Status unknown"></span>
              </div>
              <div class="service-body dashboard-twitch-body dashboard-scroll" id="twitch-channels" tabindex="0" role="region" aria-label="Twitch channels"><p class="empty-msg">No Twitch channels configured.</p></div>
              <% if (needsReconnect) { %>
              <!-- The viewer's own Twitch token has failed (the modal below says so once). This keeps a way back to the reconnect page after
                   the modal is dismissed. It is about the viewer's account, not a fault of the channels listed above. -->
              <div class="service-foot">
                <a href="/user/settings/twitch-connect" class="btn btn-sm" id="twitch-reconnect-link">Reconnect your Twitch account</a>
              </div>
              <% } %>
            </div>

          </div>

        </div>
      </section>

      <!-- Right-hand column: Stream Overview (your own channel), then the live event feed. Both come after System Status in source order,
           so screen readers and keyboard users reach them right after it; on desktop the grid places the column
           (sticky, capped to the viewport) beside every row, and the feed takes whatever height the panel leaves. -->
      <div class="dashboard-side">

        <!-- ── Stream Overview: is my channel broadcasting? About the signed-in user's own channel only (the Twitch
             Channels list above already shows every channel's LIVE badge, so nothing here repeats it). Built from the
             channel's isLive flag alone (dashboard-stream.js), never from the bot's connection, and it starts Unknown.
             It is its own panel, apart from System Status: its own heading, layout and icons, repeating no service state. ── -->
        <section class="section dashboard-stream" id="stream-overview" aria-labelledby="stream-overview-title">
          <h2 class="section-title" id="stream-overview-title">Stream Overview</h2>
          <div class="card stream-card">
            <div class="stream-own" id="stream-own">
              <h3 class="stream-heading">Your channel</h3>
              <p class="stream-state stream-state--unknown" id="stream-own-state" aria-live="polite">Unknown</p>
              <p class="stream-channel" id="stream-own-name" hidden></p>
              <p class="stream-note" id="stream-own-note">Waiting for live data.</p>
              <a class="stream-link" id="stream-own-link" target="_blank" rel="noopener noreferrer" hidden></a>
              <!-- Live stats for your own channel (dashboard-stream-stats.js, from /dashboard/stream/events): shown only
                   while it is live, each row only when Twitch gave a value for it. Title and category are Twitch's text:
                   the script writes them with textContent, inside <bdi> so a right-to-left title can't reorder the label. -->
              <dl class="stream-stats" id="stream-stats" hidden>
                <div class="stream-stat" id="stream-stat-viewers" hidden><dt>Viewers</dt><dd id="stream-stat-viewers-value"></dd></div>
                <div class="stream-stat" id="stream-stat-uptime" hidden><dt>Uptime</dt><dd id="stream-stat-uptime-value"></dd></div>
                <div class="stream-stat stream-stat--wide" id="stream-stat-category" hidden><dt>Category</dt><dd id="stream-stat-category-dd"><bdi id="stream-stat-category-value"></bdi></dd></div>
                <div class="stream-stat stream-stat--wide" id="stream-stat-title" hidden><dt>Title</dt><dd id="stream-stat-title-dd"><bdi id="stream-stat-title-value"></bdi></dd></div>
              </dl>
              <p class="stream-note" id="stream-stats-note" hidden></p>
            </div>
          </div>
        </section>

        <aside class="dashboard-sidebar" aria-label="Recent events">
          <!-- ── Recent Events ── -->
          <section class="section dashboard-events">
            <h2 class="section-title">Recent Events</h2>
            <div class="card">
              <div class="card-body dashboard-events-body dashboard-scroll" id="recent-events-list" tabindex="0" role="region" aria-label="Recent events feed">
                <% if (!user) { %>
                <p class="empty-msg">Sign in to see recent activity.</p>
                <% } else if (!hasStreamer) { %>
                <p class="empty-msg">Connect your Twitch account to see recent activity.</p>
                <% } else { %>
                <p class="empty-msg">No recent activity yet.</p>
                <% } %>
              </div>
            </div>
          </section>
        </aside>

      </div>

    </div>
  </main>

  <%- include('partials/pwa-register') %>
  <%- include('partials/footer') %>
  <script src="/dashboard-utils.js"></script>
  <script src="/dashboard-context.js"></script>
  <script src="/dashboard-layout.js"></script>
  <script src="/dashboard-health.js"></script>
  <script src="/dashboard-stream.js"></script>
  <script src="/dashboard-stream-stats.js"></script>
  <script src="/dashboard-last-played.js"></script>
  <script src="/dashboard-status.js"></script>
  <script src="/dashboard-voice.js"></script>
  <script src="/dashboard-events.js"></script>
  <script src="/app.js"></script>

  <% if (needsReconnect) { %>
  <div id="reconnect-modal" class="reconnect-modal-overlay">
    <div class="reconnect-modal-card">
      <div class="reconnect-modal-icon">⚠️</div>
      <h2 class="reconnect-modal-title">Twitch Reconnection Required</h2>
      <p class="reconnect-modal-text">Your Twitch connection is missing required permissions and some notifications are not working.</p>
      <p class="reconnect-modal-subtext">Please reconnect your Twitch account to restore full functionality.</p>
      <div class="reconnect-modal-actions">
        <a href="/user/settings/twitch-connect" class="btn">Reconnect Twitch</a>
        <button id="dismiss-reconnect-modal" class="btn btn-ghost">Dismiss</button>
      </div>
    </div>
  </div>
  <script src="/dashboard-reconnect.js"></script>
  <% } %>
</body>
</html>
