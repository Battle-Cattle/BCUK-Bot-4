<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BCUK Bot — Dashboard</title>
  <link rel="stylesheet" href="/style.css">
  <%- include('partials/pwa-head') %>
<%
function htmlAttrJson(value) {
  const replacements = { '&': '&amp;', '"': '&quot;', "'": '&#39;', '<': '&lt;', '>': '&gt;' };
  return JSON.stringify(value).replace(/[&"'<>]/g, function(char) { return replacements[char] || char; });
}
%>
</head>
<!-- Unescaped EJS output here is intentional: htmlAttrJson() already HTML-escapes its result via manual character replacement, so the escaping EJS tag would double-escape the attribute value. -->
<body data-initial-status="<%- htmlAttrJson(status) %>" data-initial-events="<%- htmlAttrJson(recentEvents) %>" data-has-streamer="<%= hasStreamer %>" data-csrf-token="<%= csrfToken %>">
  <%- include('partials/nav') %>

  <main class="container">

    <!-- ── Status Cards ── -->
    <section class="section">
      <h2 class="section-title">Bot Status</h2>
      <div class="status-grid">

        <div class="card" id="card-discord">
          <div class="card-header">
            <span class="card-icon">💬</span>
            <span class="card-label">Discord Bot</span>
            <span class="dot dot--offline" id="dot-discord"></span>
          </div>
          <div class="card-body">
            <div class="stat-row"><span class="stat-label">Account</span><span class="stat-value" id="discord-tag">—</span></div>
            <div class="stat-row"><span class="stat-label">Server</span><span class="stat-value" id="discord-guild">—</span></div>
          </div>
        </div>

        <div class="card" id="card-voice">
          <div class="card-header">
            <span class="card-icon">🔊</span>
            <span class="card-label">Voice Channel</span>
            <span class="dot dot--offline" id="dot-voice"></span>
          </div>
          <div class="card-body">
            <div class="stat-row"><span class="stat-label">Channel</span><span class="stat-value" id="voice-channel">—</span></div>
            <div class="stat-row"><span class="stat-label">State</span><span class="stat-value" id="voice-state">Idle</span></div>
            <% if (user && user.accessLevel >= 1) { %>
            <div class="stat-row stat-row-top-gap">
              <div class="d-flex gap-05 items-center">
                <select class="btn btn-sm flex-1 min-w-120" id="voice-channel-select">
                  <option value="">Loading channels...</option>
                </select>
                <button class="btn btn-sm" id="btn-rejoin-voice"><%= status.voice.connected ? 'Leave Voice' : 'Join Voice' %></button>
              </div>
            </div>
            <% } %>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <span class="card-icon">🎵</span>
            <span class="card-label">Last Played</span>
          </div>
          <div class="card-body">
            <div class="stat-row"><span class="stat-label">Command</span><span class="stat-value mono" id="last-command">—</span></div>
            <div class="stat-row"><span class="stat-label">File</span><span class="stat-value mono" id="last-file">—</span></div>
            <div class="stat-row"><span class="stat-label">Source</span><span class="stat-value" id="last-source">—</span></div>
            <div class="stat-row"><span class="stat-label">When</span><span class="stat-value" id="last-when">—</span></div>
          </div>
        </div>

      </div>
    </section>

    <!-- ── Usage ── -->
    <section class="section">
      <h2 class="section-title">Usage</h2>
      <div class="status-grid">
        <div class="card"><div class="card-body stat-card-body"><span class="stat-big"><%= usageStats.sfxCount %></span><span class="stat-big-label">SFX Triggers</span></div></div>
        <div class="card"><div class="card-body stat-card-body"><span class="stat-big"><%= usageStats.commandCount %></span><span class="stat-big-label">Custom Commands</span></div></div>
        <div class="card"><div class="card-body stat-card-body"><span class="stat-big"><%= usageStats.counterCount %></span><span class="stat-big-label">Counters</span></div></div>
        <div class="card"><div class="card-body stat-card-body"><span class="stat-big"><%= Object.keys(status.twitch).length %></span><span class="stat-big-label">Twitch Channels</span></div></div>
      </div>
    </section>

    <!-- ── Quick Links ── -->
    <section class="section">
      <h2 class="section-title">Quick Links</h2>
      <div class="quick-links-grid">
        <a href="/sfx" class="quick-link-card"><span class="quick-link-icon">🎧</span><span class="quick-link-label">SFX</span></a>
        <% if (user && user.accessLevel >= 2) { %>
        <a href="/commands" class="quick-link-card"><span class="quick-link-icon">💻</span><span class="quick-link-label">Commands</span></a>
        <a href="/counters" class="quick-link-card"><span class="quick-link-icon">🔢</span><span class="quick-link-label">Counters</span></a>
        <% } %>
        <a href="/channel-points" class="quick-link-card"><span class="quick-link-icon">🪙</span><span class="quick-link-label">Channel Points</span></a>
        <a href="/alerts/settings" class="quick-link-card"><span class="quick-link-icon">🔔</span><span class="quick-link-label">Alerts</span></a>
      </div>
    </section>

    <!-- ── Channels ── -->
    <section class="section">
      <h2 class="section-title">Channels</h2>
      <div class="channels-grid">
        <div class="card">
          <div class="card-header"><span class="card-icon">🟣</span><span class="card-label">Twitch</span></div>
          <div class="card-body" id="twitch-channels"><p class="empty-msg">No Twitch channels configured.</p></div>
        </div>
      </div>
    </section>

    <!-- ── Recent Events ── -->
    <section class="section">
      <h2 class="section-title">Recent Events</h2>
      <div class="card">
        <div class="card-body" id="recent-events-list">
          <% if (!user) { %>
          <p class="empty-msg">Sign in to see recent activity.</p>
          <% } else if (!hasStreamer) { %>
          <p class="empty-msg">Connect your Twitch account to see recent activity.</p>
          <% } else { %>
          <p class="empty-msg">No recent activity yet.</p>
          <% } %>
        </div>
      </div>
    </section>

  </main>

  <%- include('partials/pwa-register') %>
  <%- include('partials/footer') %>
  <script src="/dashboard-utils.js"></script>
  <script src="/dashboard-status.js"></script>
  <script src="/dashboard-voice.js"></script>
  <script src="/dashboard-events.js"></script>
  <script src="/app.js"></script>

  <% if (needsReconnect) { %>
  <div id="reconnect-modal" class="reconnect-modal-overlay">
    <div class="reconnect-modal-card">
      <div class="reconnect-modal-icon">⚠️</div>
      <h2 class="reconnect-modal-title">Twitch Reconnection Required</h2>
      <p class="reconnect-modal-text">Your Twitch connection is missing required permissions and some notifications are not working.</p>
      <p class="reconnect-modal-subtext">Please reconnect your Twitch account to restore full functionality.</p>
      <div class="reconnect-modal-actions">
        <a href="/user/settings/twitch-connect" class="btn">Reconnect Twitch</a>
        <button id="dismiss-reconnect-modal" class="btn btn-ghost">Dismiss</button>
      </div>
    </div>
  </div>
  <script src="/dashboard-reconnect.js"></script>
  <% } %>
</body>
</html>
