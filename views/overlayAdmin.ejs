<%- include('partials/head', { pageTitle: 'BCUK Bot — Video Overlay' }) %>
</head>
<body data-csrf-token="<%= csrfToken %>">
  <%- include('partials/nav') %>

  <main class="container">

    <% if (error) { %>
    <div class="card card-alert-danger">
      <% const errorMessages = {
        not_a_streamer:   'You are not configured as a monitored streamer.',
        invalid_file:     'No valid file was uploaded. Accepted formats: WebM, MP4, MOV.',
        transcode_failed: 'The MOV file could not be converted to WebM. Check it plays locally, or export it as WebM.',
        transcode_busy:   'Other videos are being converted right now. Try again in a few minutes.',
        upload_busy:      'Another upload is already in progress. Try again once it finishes.',
        upload_incomplete:'The upload did not finish arriving — please try again.',
        upload_expired:   'The upload expired before it finished — please try again.',
        invalid_upload:   'No valid file was chosen.',
        upload_failed:    'Upload failed — please try again.',
        delete_failed:    'Delete failed — please try again.',
        invalid_reward_id:'Invalid reward ID format. Paste the UUID from your Twitch dashboard.',
        no_videos_selected:'Select at least one video to assign to the reward.',
        invalid_weight:   `Each video weight must be a whole number from 1 to ${maxVideoWeight}.`,
        save_failed:      'Failed to save — please try again.',
        invalid_id:       'Invalid request.',
        file_too_large:   `That file is too large (max ${maxFileMb} MB).`,
      }; %>
      <%= errorMessages[error] ?? `An error occurred (${error}).` %>
    </div>
    <% } %>

    <% if (success) { %>
    <div class="card card-alert-success">
      <% const successMessages = {
        video_uploaded: 'Video uploaded successfully.',
        video_deleted:  'Video deleted.',
        reward_saved:   'Reward assignment saved.',
        reward_deleted: 'Reward assignment removed.',
      }; %>
      <%= successMessages[success] ?? 'Done.' %>
    </div>
    <% } %>

    <% if (!streamer) { %>
    <%- include('partials/notStreamerCard') %>
    <% } else { %>

    <%- include('partials/obsBrowserSource', { overlayPath: 'overlay' }) %>

    <!-- ── Video Library ──────────────────────────────────────────── -->
    <section class="section">
      <h2 class="section-title">Video Library</h2>

      <div class="card card-spaced">
        <div class="card-body">
          <!-- Sent by registerUploadFormHandler (utils.js, via chunkedUpload.js) as a chunked,
               resumable upload to the routes under its action, with the CSRF token in an
               X-CSRF-Token header, so the session token is never placed in the URL (browser
               history / Referer). It fills the progress bar below as pieces arrive, then polls
               data-progress-url while a MOV converts. -->
          <form method="POST" action="/overlay/settings/videos/upload" enctype="multipart/form-data" class="js-overlay-upload"
                data-progress-url="/overlay/settings/videos/progress" data-processing-label="Saving…">
            <div class="form-row-wrap items-end">
              <div class="flex-1">
                <label class="hint hint-compact" for="video-name">Name</label>
                <input id="video-name" class="input" type="text" name="name" maxlength="100" placeholder="e.g. Confetti Explosion">
              </div>
              <div class="flex-1">
                <label class="hint hint-compact" for="video-file">Video file (WebM, MP4 or MOV)</label>
                <input id="video-file" class="input" type="file" name="video" accept="video/webm,video/mp4,video/quicktime,.mov" required>
              </div>
              <div>
                <button type="submit" class="btn">Upload</button>
              </div>
            </div>
            <div class="upload-progress is-hidden mt-04" data-upload-progress>
              <progress class="upload-progress-bar" max="100" value="0" aria-label="Upload progress"></progress>
              <span class="hint" data-upload-progress-label role="status" aria-live="polite"></span>
            </div>
            <p class="hint mt-04">For transparent overlays, upload WebM with an alpha channel or a MOV (e.g. ProRes 4444): MOV files are converted to WebM on upload, keeping transparency, which can take a minute. Max <%= maxFileMb %> MB.</p>
          </form>
        </div>
      </div>

      <% if (videos.length === 0) { %>
      <div class="card">
        <div class="card-body">
          <p class="hint">No videos uploaded yet.</p>
        </div>
      </div>
      <% } else { %>
      <div class="card">
        <div class="table-scroll">
          <table class="table full-width">
            <thead>
              <tr>
                <th>Name</th>
                <th>File</th>
                <th>Uploaded</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% for (const v of videos) { %>
              <tr>
                <td><%= v.name %></td>
                <td class="mono fs-08em"><%= v.filename %></td>
                <td><%= new Date(v.created_at).toLocaleDateString() %></td>
                <td>
                  <form method="POST" action="/overlay/settings/videos/<%= v.id %>/delete" class="m-0 js-confirm-delete-video">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-ghost btn-sm">
                      Delete
                    </button>
                  </form>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>
    </section>

    <!-- ── Reward Assignments ─────────────────────────────────────── -->
    <section class="section">
      <h2 class="section-title">Reward Assignments</h2>
      <p class="hint mb-075">
        Assign channel point rewards to overlay videos. Each reward can have multiple videos — one is picked at random (weighted) when redeemed.
      </p>

      <% if (videos.length === 0) { %>
      <div class="card">
        <div class="card-body">
          <p class="hint">Upload at least one video before creating a reward assignment.</p>
        </div>
      </div>
      <% } else { %>

      <div class="card card-spaced">
        <div class="card-body">
          <form method="POST" action="/overlay/settings/rewards" id="reward-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-075">
              <label class="hint hint-compact" for="reward-id">Twitch Reward</label>
              <% if (twitchRewards.length > 0) { %>
              <select id="reward-id" class="input" name="twitch_reward_id" required>
                <option value="" disabled selected>— select a reward —</option>
                <% for (const tr of twitchRewards) { %>
                <option value="<%= tr.id %>"><%= tr.title %> (<%= tr.cost.toLocaleString() %> pts<%= tr.is_enabled ? '' : ' · disabled' %>)</option>
                <% } %>
              </select>
              <% } else { %>
              <input id="reward-id" class="input" type="text" name="twitch_reward_id"
                pattern="[0-9a-fA-F\-]{36}" maxlength="36" required
                placeholder="e.g. 12345678-abcd-1234-abcd-1234567890ab">
              <p class="hint mt-025">Connect your Twitch account in <a href="/user/settings">User Settings</a> to pick rewards by name.</p>
              <% } %>
            </div>
            <p class="hint hint-compact">Videos &amp; weights (higher weight = more likely):</p>
            <div id="video-assignments" class="mt-04">
              <% for (const v of videos) { %>
              <div class="form-row-wrap mb-04 items-center">
                <label class="flex-3 d-flex items-center gap-05">
                  <input type="checkbox" name="video_ids" value="<%= v.id %>">
                  <%= v.name %>
                </label>
                <div class="flex-1 d-flex items-center gap-04">
                  <span class="hint hint-compact nowrap">Weight</span>
                  <input class="input w-5rem" type="number" name="weight_<%= v.id %>" value="1" min="1" max="<%= maxVideoWeight %>" step="1">
                </div>
              </div>
              <% } %>
            </div>
            <div class="button-row-wrap mt-075">
              <button type="submit" class="btn">Save Assignment</button>
            </div>
          </form>
        </div>
      </div>

      <% } %>

      <!-- Existing assignments -->
      <% if (rewards.length > 0) { %>
      <% for (const r of rewards) { %>
      <div class="card card-spaced">
        <div class="card-body">
          <div class="form-row-wrap items-center justify-between">
            <div>
              <p class="hint hint-compact">Reward ID</p>
              <code class="mono reward-id-display"><%= r.twitch_reward_id %></code>
            </div>
            <form method="POST" action="/overlay/settings/rewards/<%= r.id %>/delete" class="m-0 js-confirm-delete-reward">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-ghost btn-sm">
                Remove
              </button>
            </form>
          </div>
          <% if (r.videos.length > 0) { %>
          <div class="table-scroll mt-075">
            <table class="table full-width">
              <thead>
                <tr><th>Video</th><th>Weight</th></tr>
              </thead>
              <tbody>
                <% for (const v of r.videos) { %>
                <tr>
                  <td><%= v.name %></td>
                  <td><%= v.weight %></td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <p class="hint mt-05">No videos assigned.</p>
          <% } %>
        </div>
      </div>
      <% } %>
      <% } %>
    </section>

    <% } %>

  </main>

  <%- include('partials/page-end') %>
  <script src="/chunkedUpload.js"></script>
  <script src="/chunkedUploadResume.js"></script>
  <script src="/chunkedUploadOutcome.js"></script>
  <script src="/chunkedUploadPacing.js"></script>
  <script src="/overlayAdmin.js"></script>
</body>
</html>
