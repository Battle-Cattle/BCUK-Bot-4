# Discord (bot)
DISCORD_TOKEN=your_discord_bot_token_here
# Note: DISCORD_GUILD_ID and DISCORD_VOICE_CHANNEL_ID are no longer required.
# Guild and voice channel configuration is now managed in the database (guild table).

# Discord OAuth application (create at https://discord.com/developers/applications)
# Under OAuth2 -> Redirects, add: http://localhost:3000/auth/discord/callback
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback
DISCORD_CLIENT_ID=your_discord_oauth_app_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth_app_client_secret

# Twitch (chat bot)
TWITCH_USERNAME=your_bot_username
# The chat bot's own Twitch account no longer authenticates via a static token here — connect
# (and reconnect) it as the owner at /admin/bot-auth instead. Requires TWITCH_BOT_OAUTH_REDIRECT_URI
# and EVENTSUB_TOKEN_SECRET below to be set.

# Twitch stream monitor (live announcements in Discord)
# Create an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_app_client_id
TWITCH_CLIENT_SECRET=your_twitch_app_client_secret

# Redirect URI for the chat bot's own /admin/bot-auth OAuth "connect" flow (see above); must be
# registered in the Twitch developer console for the same app as TWITCH_CLIENT_ID above.
# TWITCH_BOT_OAUTH_REDIRECT_URI=http://localhost:3000/auth/twitch/bot/callback

# Optional: Twitch EventSub follow/sub notifications and channel-points/reward tracking.
# This is an opt-in per-streamer feature — leave unset if no streamer will use it.
# Redirect URI for the per-streamer Twitch OAuth "connect" flow; must be registered in the
# Twitch developer console for the same app as TWITCH_CLIENT_ID above.
# TWITCH_EVENTSUB_REDIRECT_URI=http://localhost:3000/eventsub/callback
# AES-256-GCM key for encrypting OAuth tokens at rest (both the per-streamer EventSub tokens
# above and the chat bot's own token) — exactly 64 hex characters (32 bytes).
# Generate with: openssl rand -hex 32
# EVENTSUB_TOKEN_SECRET=your_64_char_hex_key_here
# Only while rotating EVENTSUB_TOKEN_SECRET: the key it replaced. Tokens written under it still
# decrypt, and startup re-encrypts them under the new key. Remove it once that's done (see the
# README's "Rotating EVENTSUB_TOKEN_SECRET").
# EVENTSUB_TOKEN_SECRET_PREVIOUS=

# MySQL Database
DB_HOST=localhost
DB_NAME=your_db_name
DB_PASSWORD=your_db_password
DB_PORT=3306
DB_USER=root
# Optional: where scripts/backup-db.sh (run by deploy.sh before every restart) writes database
# dumps, and how many it keeps. Dumps hold the encrypted OAuth tokens: keep them private.
# BACKUP_DIR=/home/bot/bcuk-bot-backups
# BACKUP_KEEP=14

# Bot settings
# Global cooldown in milliseconds between any two sound plays (a whole number, 0 or more)
GLOBAL_COOLDOWN_MS=3000
# Optional: log level (error, warn, info, debug) for combined-*.log and the console. Defaults to
# info under `npm start` (NODE_ENV=production) and debug otherwise. For a temporary debug log, use
# the Health page or `npm run deploy debug` instead (README "Debug logging").
# LOG_LEVEL=info
# Path to the folder containing .mp3/.wav sound files.
# Upload folders (this, OVERLAY_FOLDER, ALERT_ASSETS_FOLDER) must be writable only by the bot's user; see README "Deployment".
SFX_FOLDER=./sfx
# Optional: maximum size (in MB) for an SFX upload via the web panel
# SFX_MAX_FILE_MB=10
# Optional: folder where SFX and alert image/sound uploads are assembled from their pieces before
# they're checked and stored (overlay videos use OVERLAY_FOLDER/.incoming). Abandoned uploads are
# removed after an hour. Like the upload folders, writable only by the bot's user.
# UPLOAD_INCOMING_FOLDER=./upload-incoming
# Optional: path to the folder containing overlay video files
# OVERLAY_FOLDER=./overlay-videos
# Optional: maximum size (in MB) for an overlay video upload via the web panel. Uploads arrive in
# resumable 8 MB pieces, assembled on disk (OVERLAY_FOLDER/.incoming) rather than in memory, so
# transparent ProRes MOVs of a few hundred MB are fine. A reverse proxy in front of the panel only
# needs a body limit above one piece (8 MB, plus a little for headers), whatever this value is.
# Completing a MOV upload waits for its conversion, so a proxy also needs a read timeout longer
# than OVERLAY_TRANSCODE_TIMEOUT_MINUTES; see README "Uploads and reverse proxies".
# OVERLAY_MAX_FILE_MB=500
# Optional: longest one MOV → WebM overlay conversion may run (minutes) before it's stopped.
# Converting a few hundred MB of transparent ProRes can take well over five minutes.
# OVERLAY_TRANSCODE_TIMEOUT_MINUTES=30
# Optional: maximum concurrent SSE connections per companion app token
# COMPANION_MAX_SSE_PER_TOKEN=3
# Optional: maximum concurrent SSE connections per overlay channel
# OVERLAY_MAX_SSE_PER_CHANNEL=10
# Optional: maximum concurrent SSE connections per streamer to the overlay settings page's
# live "is my overlay connected?" status stream
# OVERLAY_STATUS_MAX_SSE_PER_STREAMER=3
# Optional: maximum concurrent SSE connections per channel-points streamer
# CHANNEL_POINTS_MAX_SSE_PER_STREAMER=5
# Optional: maximum concurrent SSE connections per dashboard events stream, per streamer
# DASHBOARD_EVENTS_MAX_SSE_PER_STREAMER=5
# Optional: maximum concurrent SSE connections per dashboard status stream, per guild
# DASHBOARD_STATUS_MAX_SSE_PER_GUILD=10
# Optional: maximum total concurrent SSE connections across the whole server
# SSE_MAX_TOTAL_CONNECTIONS=500
# Optional: path to the folder containing alerts-overlay image/sound uploads
# ALERT_ASSETS_FOLDER=./alert-assets
# Optional: maximum size (in MB) for an alert image/GIF upload via the web panel
# ALERT_MAX_IMAGE_MB=10
# Optional: maximum size (in MB) for an alert sound upload via the web panel
# ALERT_MAX_SOUND_MB=5
# Optional: maximum concurrent SSE connections per alerts-overlay channel
# ALERT_MAX_SSE_PER_CHANNEL=10
# Optional: maximum concurrent SSE connections per streamer to the alerts settings page's
# live "is my alerts overlay connected?" status stream
# ALERT_STATUS_MAX_SSE_PER_STREAMER=3
# Optional: OpenAI API key for the owner-only "Suggest description" SFX feature
# (analyses an uploaded sound and suggests a description). Leave unset to disable it.
# OPENAI_API_KEY=your_openai_api_key_here

# Web panel
# Random secret string for signing session cookies — MUST be changed to a long random value
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=__REQUIRED_GENERATE_LONG_RANDOM_SECRET__
WEB_PORT=3000
# Optional: interface the web panel listens on (default 127.0.0.1). The panel trusts exactly one
# proxy hop, so it must only be reachable through the reverse proxy (Caddy). Only change this to a
# private interface if the proxy runs on another host or in a container — never 0.0.0.0 on a
# host whose WEB_PORT is reachable from the internet.
# WEB_HOST=127.0.0.1
