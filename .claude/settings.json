{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__create_pull_request|mcp__github__update_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/workflow-guard.mjs\" pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ReadNotifications",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/workflow-guard.mjs\" notify"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm test*)",
      "Bash(npm run build*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run lint*)",
      "Bash(npx vitest run*)",
      "Bash(npx eslint*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(find . *)",
      "Bash(grep -rn * src*)",
      "Bash(grep -r * src*)",
      "Bash(grep -n * src*)",
      "Bash(grep -l * src*)",
      "Bash(grep -rn * views*)",
      "Bash(grep -r * views*)",
      "Bash(grep -n * views*)",
      "Bash(grep -rn * public*)",
      "Bash(grep -r * public*)",
      "Bash(grep -n * public*)",
      "Bash(grep -rn * migrations*)",
      "Bash(grep -r * migrations*)",
      "Bash(grep -n * migrations*)"
    ]
  }
}
