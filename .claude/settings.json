{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm test*)",
      "Bash(npm run build*)",
      "Bash(npx tsc*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(find . *)",
      "Bash(grep -rn * src*)",
      "Bash(grep -r * src*)",
      "Bash(grep -n * src*)",
      "Bash(grep -l * src*)",
      "Bash(grep -rn * views*)",
      "Bash(grep -r * views*)",
      "Bash(grep -n * views*)",
      "Bash(grep -rn * public*)",
      "Bash(grep -r * public*)",
      "Bash(grep -n * public*)",
      "Bash(grep -rn * migrations*)",
      "Bash(grep -r * migrations*)",
      "Bash(grep -n * migrations*)"
    ]
  }
}
