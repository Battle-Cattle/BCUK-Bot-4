# systemd unit for the bot. Don't copy this by hand: scripts/install-systemd-service.sh fills in
# the __PLACEHOLDERS__ and installs it as /etc/systemd/system/bcuk-bot.service.
[Unit]
Description=BCUK Bot 4 (Discord/Twitch bot and web panel)
# Ordering only: a remote MySQL simply has no local unit, which systemd ignores.
After=network-online.target mysql.service mariadb.service
Wants=network-online.target
# Never stop retrying: a database or network outage makes every start fail (main() exits 1 on a
# failed DB ping), and nothing would start the bot again once systemd gave up. The backoff below
# keeps a long crash loop from hammering Discord/Twitch logins instead.
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_DIR__
Environment=NODE_ENV=production
ExecStart=__NODE_BIN__ dist/index.js
# The bot exits 1 on any fatal error (see the Startup Sequence in CLAUDE.md) and 0 after a
# SIGTERM shutdown, so this restarts crashes but not deliberate stops.
Restart=on-failure
# First retry after 10s, then backing off over 5 retries to one attempt every 5 minutes (about
# 300 a day at most). RestartSteps/RestartMaxDelaySec need systemd 254+; older systemd warns
# about them and simply retries every 10s.
RestartSec=10
RestartSteps=5
RestartMaxDelaySec=300
KillSignal=SIGTERM
# shutdown() announces itself to the owner and closes Discord/Twitch/DB cleanly first.
TimeoutStopSec=30

# Sandboxing (defence in depth): limits what a compromised Node process (a dependency, or ffmpeg
# parsing an upload) could reach. Check with `systemd-analyze security bcuk-bot`.
NoNewPrivileges=true
PrivateTmp=true
# The whole filesystem is read-only to the bot, and /home, /root and /run/user are replaced with
# empty directories, so a compromised process can't read the account's other files (SSH keys,
# credentials, other projects). Only what the bot needs is put back, by the two Bind lines below.
ProtectSystem=strict
ProtectHome=tmpfs
# Read-only: the checkout (code, node_modules and .env) and the Node install, which usually live in a
# home directory. The installer fills these in.
BindReadOnlyPaths=__READONLY_PATHS__
# Read-write: everywhere the bot writes at runtime, logs/ (log files and the debug-logging state
# file) and the three upload folders (MOV-to-WebM conversion writes its temporary files there too).
# The installer fills these in from .env and creates them; `-` keeps a missing one from stopping the
# service.
BindPaths=__WRITABLE_PATHS__
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
# Not MemoryDenyWriteExecute=true: V8's JIT needs writable+executable memory, and node would crash.

[Install]
WantedBy=multi-user.target
